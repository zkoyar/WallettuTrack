{
  "name": "wallettutrack",
  "version": "0.2.4",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --dependencies",
    "db:generate": "prisma generate",
    "predev": "npm run db:generate",
    "dev": "next dev",
    "prebuild": "npm run db:generate",
    "build": "next build",
    "start": "next start",
    "serve": "next start -H 0.0.0.0 -p 3001",
    "lint": "eslint",
    "pretypecheck": "npm run db:generate",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "test": "vitest run",
    "security:audit": "npm audit --audit-level=high",
    "release:check": "npm run check && npm run build && npm run security:audit",
    "package:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1 -Architecture all"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.41.0",
    "mariadb": "3.5.4",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "prisma": "^7.10.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "mariadb": "3.5.4",
    "mysql2": "3.24.3"
  }
}
